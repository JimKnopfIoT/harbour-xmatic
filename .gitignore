# Build output
Makefile
*.o
moc_*.cpp
moc_*.h
qrc_*.cpp
.qmake.stash
RPMS/
installroot/
build/
*.rpm
documentation.list
translations/*.qm

# The linked application binary, dropped in the repo root by the qmake build
/harbour-xmatic

# Rust core: the cross-built static library and the cbindgen-generated header
core/target/
src/generated/

# Sailfish SDK / Qt Creator local state
.mb2/
*.pro.user*

# Python
__pycache__/
*.pyc

# Local / private notes — never publish (contain personal or device data)
CLAUDE.md
HANDOFF.md
STATUS.md
PUBLISH.md
# `docs/*` and not `docs/`: git cannot re-include a file whose parent directory
# is excluded, and one file in there has to ship. The push notification page
# and the OpenRepos description both point at it, so it must exist where they
# point; it is written for users, not for developers.
docs/*
!docs/PUSH.md
research/
.claude/
*.local.sh
tools/

# Local data / captures
*.log

# Regenerated by lupdate on every build (sailfishapp_i18n adds it itself).
translations/harbour-xmatic.ts
translations/*.qm
